# Backend API Configuration

# Gemma-3n Legal Assistant with RAG (for general queries and streaming)
NEXT_PUBLIC_GEMMA_API_URL=http://localhost:8000
# For Modal deployment:
# NEXT_PUBLIC_GEMMA_API_URL=https://your-org--legal-ai-gemma-rag-fastapi-app.modal.run

# CJPE Scorer (for court judgment prediction)
NEXT_PUBLIC_CJPE_API_URL=http://localhost:8001
# For Modal deployment:
# NEXT_PUBLIC_CJPE_API_URL=https://your-org--legal-ai-inlegalbert-higru-cjpe-scorer-fastapi-app.modal.run

# Default backend (fallback if specific endpoint not set)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: API Key if backend requires authentication
# NEXT_PUBLIC_API_KEY=your_api_key_here

# Optional: Enable debug logging
# NEXT_PUBLIC_DEBUG=false

# Optional: Backend timeout (ms)
# NEXT_PUBLIC_API_TIMEOUT=30000
